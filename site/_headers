# Cloudflare Workers Static Assets headers.
# CSP note: all CSS/JS is inline by design (zero external subresources), so
# 'unsafe-inline' is required; connect-src 'self' covers the live verifier
# form's same-origin /v1 calls.

# TDM Reservation Protocol, declared on the PAGES only and deliberately not on
# the /v1 data responses. The pages are original work. The figures in an API
# response belong to the World Bank, IMF, ECB and BIS, and stamping our
# reservation on their data would be exactly the conflation terms.html#reuse
# exists to prevent. Reserved here means: do not mine this to train a model.
# Reading, indexing and citing stay open, which robots.txt states explicitly.
/*
  TDM-Reservation: 1
  TDM-Policy: https://statcite.com/terms#reuse
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY

# Machine-readable spec files: browser-side consumers (Swagger UI, client-side
# importers, agent fetchers) need CORS on the static assets, not only on /v1.
/openapi.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms-full.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=86400

# The TDM reservation document itself must be readable by any client that wants
# to check it, including cross-origin fetchers.
/.well-known/tdmrep.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Social card and icons. Long cache: these change only when the brand does, and
# Slack/X/LinkedIn fetch og.png on every unfurl.
/og.png
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
