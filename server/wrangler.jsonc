{
  // StatCite — Cloudflare Workers configuration.
  // Free plan is sufficient: 100k requests/day, static assets free & unlimited.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statcite",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // API routes are handled by the Worker; everything else is served as a static asset.
    "run_worker_first": ["/mcp", "/mcp/*", "/v1", "/v1/*", "/health"]
  },
  "vars": {
    // Public base URL of this deployment. Update after wiring the custom domain.
    "BASE_URL": "https://statcite.com"
  },
  // Custom domain routes — statcite.com is registered in this Cloudflare account.
  "routes": [
    { "pattern": "statcite.com", "custom_domain": true },
    { "pattern": "www.statcite.com", "custom_domain": true }
  ],
  // Aggregate usage analytics — see core/analytics.ts. Privacy: only
  // tool/endpoint, indicator key, country ISO3, verdict kind, transport,
  // outcome and a duration bucket are recorded; never IP, UA or free text.
  //
  // The Analytics Engine binding below is DISABLED: the dataset exists
  // (statcite_usage / STATCITE_USAGE, created 2026-07-25) but this account's
  // deploys are rejected with API error 10089 "You need to enable Analytics
  // Engine" — it is gated behind Workers Paid despite the free-tier pricing
  // page. recordUsage() emits its `STATCITE_USAGE {json}` console line
  // unconditionally, so usage telemetry works today at zero cost via
  // observability (npx wrangler tail --search STATCITE_USAGE). Uncomment this
  // line only if the account moves to Workers Paid.
  // "analytics_engine_datasets": [{ "binding": "STATCITE_USAGE", "dataset": "statcite_usage" }],
  "observability": { "enabled": true }
  // Secrets (set via `wrangler secret put`):
  //   FRED_API_KEY — INERT. FRED is permanently disabled (server/src/adapters/fred.ts
  //                  declines unconditionally per a verified terms-of-use conflict).
  //                  Do not set; do not re-enable without re-reading the current ToU.
}
