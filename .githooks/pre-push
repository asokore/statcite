#!/bin/sh
# Embargo guard. TRACKED copy — see CLAUDE.md "Branch topology and the embargo
# guard" for why this exists and how to enable it.
#
# Local `main` carries the R2 benchmark RESULTS (bench/runs/R2*), which stay off
# the public remote until the vendor courtesy-preview window closes. This hook
# refuses a push in two cases:
#
#   1. the TIP TREE contains embargoed paths. Tree membership, not range diffs,
#      because a new-branch push has no range and the first version of this
#      guard silently passed on exactly that case.
#   2. any COMMIT the push would add carries them, even if a later commit
#      deleted them. The tip-only check let a branch that added the results and
#      then removed them publish the files in its history.
#
# (bench/questions/R2* and bench/snapshots/R2* are pre-registered and public by
# design — only runs/ is embargoed.)
#
# Further down it also refuses harvested bank data, a non-noreply identity, a
# line with no history in common with the remote's main, an AI attribution
# trailer or stamp, and any retired phrase listed in the clone's local
# .git/info/push-deny-patterns. Each case is mutation-tested through a real
# `git push --dry-run` to a new branch, which reaches this hook.
#
# THIS FILE IS NOT ACTIVE UNTIL ENABLED. Git never runs hooks straight from a
# clone, by design. Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# Verify it is active with `git config --get core.hooksPath` (expect
# `.githooks`). If that prints nothing, this guard is NOT protecting you and a
# plain `git push` from main would publish the embargoed results.

remote="$1"
while read local_ref local_sha remote_ref remote_sha; do
  # A delete-push sends the all-zero sha; nothing to inspect.
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  leaked=$(git ls-tree -r --name-only "$local_sha" -- bench/runs 2>/dev/null | grep -E "^bench/runs/R2" | head -5)
  if [ -n "$leaked" ]; then
    echo "PUSH REFUSED: the pushed tree ($local_ref) contains embargoed R2 results:" >&2
    echo "$leaked" >&2
    echo "Push via the public-sync branch (git push origin public-sync:main), which excludes bench/runs/R2*." >&2
    exit 1
  fi
  # The banks' own harvested series are published from their own repository, and
  # .gitignore only stops a plain `git add`. A force-add would put 62MB of ECCB
  # and CBB material into this public tree, where it can drift from the copy the
  # licence ledger names and the Worker actually fetches.
  harvest=$(git ls-tree -r --name-only "$local_sha" -- caribstat .capture 2>/dev/null | grep -E "^(caribstat/(data|reference|\.publish)|\.capture)/" | head -5)
  if [ -n "$harvest" ]; then
    echo "PUSH REFUSED: the pushed tree ($local_ref) contains harvested source data:" >&2
    echo "$harvest" >&2
    echo "That corpus is published from github.com/asokore/caribstat. Remove it with git rm --cached." >&2
    exit 1
  fi
  # The public remote must not learn the maintainer's personal address. Commits
  # authored before 15 September 2026 carry it, so a cherry-pick of one would
  # reintroduce it. `git commit --amend --reset-author` fixes a refused commit.
  ident=$(git log --format='%ae%n%ce' "$local_sha" --not --remotes="$remote" 2>/dev/null | sort -u | grep -v "users.noreply.github.com" | head -5)
  if [ -n "$ident" ]; then
    echo "PUSH REFUSED: these commits ($local_ref) carry a non-noreply author or committer address:" >&2
    echo "$ident" >&2
    echo "Re-author them (git rebase --exec 'git commit --amend --no-edit --reset-author') before publishing." >&2
    exit 1
  fi
  # Every path touched by a commit the remote does not already have. Not
  # `rev-list --objects`, which names each object once at the first path it
  # meets, so results renamed elsewhere before removal went unseen.
  # --no-renames keeps the original path, --full-history keeps a merged side
  # branch that added and dropped the results, and -m shows merge diffs. When
  # the remote is a URL rather than a named remote, nothing is excluded and the
  # whole history is scanned, which fails closed.
  in_history=$(git log --format= --name-only --no-renames --full-history -m "$local_sha" --not --remotes="$remote" -- bench/runs 2>/dev/null | grep -E "^bench/runs/R2" | head -5)
  if [ -n "$in_history" ]; then
    echo "PUSH REFUSED: a commit in this push ($local_ref) carries embargoed R2 results, even if the tip does not:" >&2
    echo "$in_history" >&2
    echo "Rebuild the branch from public-sync so the results never enter its history." >&2
    exit 1
  fi
  # The public history was rewritten on 15 September 2026. Any line that shares
  # no history with the remote's main is the pre-rewrite history, which still
  # holds what the rewrite removed. A stale local branch of it survived for twelve
  # days and would have passed every check above as a new branch.
  if git rev-parse -q --verify "refs/remotes/$remote/main" >/dev/null 2>&1; then
    if ! git merge-base "$local_sha" "refs/remotes/$remote/main" >/dev/null 2>&1; then
      echo "PUSH REFUSED: $local_ref shares no history with $remote/main, so it is the pre-rewrite line." >&2
      echo "Rebuild the work on public-sync instead." >&2
      exit 1
    fi
  fi
  # No commit published here names an AI model as its author or co-author.
  vendors='claude|anthropic'
  marked=$(git log --format='%h %(trailers:key=Co-authored-by,valueonly,separator=%x20)' "$local_sha" --not --remotes="$remote" 2>/dev/null | grep -i -E " .*($vendors)" | head -5)
  stamped=$(git log --format='%h %B' "$local_sha" --not --remotes="$remote" 2>/dev/null | grep -i -E "generated (with|by) \[?($vendors)" | head -5)
  # The robot emoji, U+1F916, matched as its UTF-8 bytes. A multibyte pattern in
  # grep matched from a shell and missed under the environment git gives a hook
  # (mutation test, 28 September 2026), so compare bytes, not characters.
  if git log --format='%B' "$local_sha" --not --remotes="$remote" 2>/dev/null | od -An -v -tx1 | tr -s ' \n' '  ' | grep -q ' f0 9f a4 96'; then
    stamped="$stamped
robot emoji in a commit message"
  fi
  if [ -n "$marked$stamped" ]; then
    echo "PUSH REFUSED: commits in $local_ref carry an AI attribution trailer or stamp:" >&2
    printf '%s\n%s\n' "$marked" "$stamped" | grep . >&2
    echo "Remove the trailer (git commit --amend, or git rebase with --exec) before publishing." >&2
    exit 1
  fi
  # Retired phrases, kept OUT of this public file. Each clone lists them in
  # .git/info/push-deny-patterns (one extended regex per line, # for comments),
  # which git never commits. Absent file, no check, and a warning says so.
  deny="$(git rev-parse --git-common-dir 2>/dev/null)/info/push-deny-patterns"
  if [ -f "$deny" ]; then
    grep -v -E '^[[:space:]]*(#|$)' "$deny" | while IFS= read -r pat; do
      hit=$(git log -i -E --grep="$pat" --format='%h message' "$local_sha" --not --remotes="$remote" 2>/dev/null | head -3)
      [ -z "$hit" ] && hit=$(git log -G"$pat" -i --format='%h diff' "$local_sha" --not --remotes="$remote" 2>/dev/null | head -3)
      [ -z "$hit" ] && git grep -q -i -E "$pat" "$local_sha" -- 2>/dev/null && hit="tip tree"
      if [ -n "$hit" ]; then
        echo "PUSH REFUSED: $local_ref carries a retired phrase listed in .git/info/push-deny-patterns:" >&2
        echo "$hit" >&2
        exit 1
      fi
    done || exit 1
  else
    echo "pre-push: no .git/info/push-deny-patterns in this clone, retired-phrase check skipped." >&2
  fi
done
exit 0
