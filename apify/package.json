{
  "name": "statcite-actor",
  "version": "1.0.0",
  "type": "module",
  "description": "StatCite on Apify — official economic statistics with citations + stat verification, pay-per-event.",
  "main": "main.js",
  "scripts": {
    "build:core": "esbuild ../server/src/core-entry.ts --bundle --format=esm --platform=node --target=node20 --outfile=core.bundle.mjs",
    "start": "node main.js",
    "test:local": "node scripts/local-test.mjs"
  },
  "dependencies": {
    "apify": "^3.2.6"
  },
  "devDependencies": {
    "apify-cli": "^1.7.1",
    "esbuild": "^0.24.2"
  }
}
